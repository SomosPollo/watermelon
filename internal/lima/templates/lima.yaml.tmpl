# Auto-generated by watermelon - do not edit
minimumLimaVersion: {{ .MinimumLimaVersion }}
vmType: {{ .VMType }}
arch: default
cpus: {{ .CPUs }}
memory: {{ yamlQuote .Memory }}
disk: {{ yamlQuote .Disk }}
{{- if or .WorkspaceDisk .SetupImage }}
propagateProxyEnv: false
ssh:
  forwardAgent: false
  forwardX11: false
  forwardX11Trusted: false
  loadDotSSHPubKeys: false
{{- end }}
{{- if .WorkspaceDisk }}
# Use Lima's network DNS defaults for trusted workspace bootstrap instead of
# forcing public resolvers that may be unreachable on the host's network.
# Workload DNS is mediated separately after trusted bootstrap.
hostResolver:
  enabled: false
additionalDisks:
  - name: {{ yamlQuote .WorkspaceDisk }}
    format: {{ .FormatWorkspaceDisk }}
    fsType: ext4
{{- end }}

user:
  name: {{ yamlQuote .VMUser }}
  uid: {{ .VMUserUID }}
  home: {{ yamlQuote .VMUserHome }}
  shell: /bin/bash

images:
{{- if eq .Image "ubuntu-24.04" }}
  - location: "https://cloud-images.ubuntu.com/releases/24.04/release/ubuntu-24.04-server-cloudimg-arm64.img"
    arch: aarch64
  - location: "https://cloud-images.ubuntu.com/releases/24.04/release/ubuntu-24.04-server-cloudimg-amd64.img"
    arch: x86_64
{{- else }}
  - location: "https://cloud-images.ubuntu.com/releases/22.04/release/ubuntu-22.04-server-cloudimg-arm64.img"
    arch: aarch64
  - location: "https://cloud-images.ubuntu.com/releases/22.04/release/ubuntu-22.04-server-cloudimg-amd64.img"
    arch: x86_64
{{- end }}

{{- if or .MountProject .Mounts .BootstrapHostDir .LogHostDir }}
mounts:
{{- if .MountProject }}
  - location: {{ yamlQuote .ProjectDir }}
    mountPoint: /project
    writable: true
{{- end }}
{{- range .Mounts }}
  - location: {{ yamlQuote .Location }}
    mountPoint: {{ yamlQuote .Target }}
    writable: {{ .Writable }}
{{- end }}
{{- if .BootstrapHostDir }}
  - location: {{ yamlQuote .BootstrapHostDir }}
    mountPoint: /mnt/watermelon/bootstrap
    writable: false
{{- end }}
{{- if .LogHostDir }}
  - location: {{ yamlQuote .LogHostDir }}
    mountPoint: /mnt/watermelon/state
    writable: true
{{- end }}
{{- else }}
mounts: []
{{- end }}

provision:
  - mode: dependency
    script: |
      #!/bin/sh
      set -eu
      PATH=/usr/sbin:/usr/bin:/sbin:/bin
      export PATH
      rm -f -- /run/watermelon-provisioning-complete /run/watermelon-bootstrap-apt-configured
      # Lima installs rootless-container prerequisites before system provisions.
      # Apply these settings there too: a partial apt update otherwise returns
      # success and can leave uidmap unavailable after a transient mirror error.
      install -d -o root -g root -m 0755 /etc/apt/apt.conf.d
      cat > /etc/apt/apt.conf.d/80-watermelon-bootstrap << 'WATERMELON_APT'
      Acquire::ForceIPv4 "true";
      Acquire::Retries "5";
      Acquire::http::Timeout "30";
      Acquire::https::Timeout "30";
      APT::Update::Error-Mode "any";
      WATERMELON_APT
      chmod 0644 /etc/apt/apt.conf.d/80-watermelon-bootstrap
      install -o root -g root -m 0600 /dev/null /run/watermelon-bootstrap-apt-configured
  - mode: system
    script: |
      #!/bin/bash
      set -e
      set -o pipefail
      export PATH=/usr/sbin:/usr/bin:/sbin:/bin
      export DEBIAN_FRONTEND=noninteractive

      # Lima records provision failures but continues with later scripts and
      # may still report the guest as ready. Reset Watermelon's own per-boot
      # attestation before doing any work so a partial retry cannot inherit a
      # success marker from an earlier provisioning pass.
      /bin/rm -f -- /run/watermelon-provisioning-complete
      /bin/rm -rf -- /run/watermelon-provisioning
      /usr/bin/install -d -o root -g root -m 0700 /run/watermelon-provisioning
      if [ -f /run/watermelon-policy-applied ]; then
        exit 0
      fi

      wm_delete_jump() {
        _wm_table="$1"
        _wm_parent="$2"
        _wm_child="$3"
        while iptables -w -t "$_wm_table" -D "$_wm_parent" -j "$_wm_child" 2>/dev/null; do :; done
      }

      wm_reset_root_policy() {
        wm_delete_jump filter OUTPUT WM_OUTPUT
        iptables -w -F WM_OUTPUT 2>/dev/null || true
        iptables -w -X WM_OUTPUT 2>/dev/null || true
        wm_delete_jump nat OUTPUT WM_DNS_OUT
        iptables -w -t nat -F WM_DNS_OUT 2>/dev/null || true
        iptables -w -t nat -X WM_DNS_OUT 2>/dev/null || true
{{- if eq .Enforcement "ask" }}
        while iptables -w -D INPUT -p udp --sport 53 -j NFQUEUE --queue-num 1 2>/dev/null; do :; done
{{- end }}
      }

      _WM_FIRST_BOOT=false
      if [ ! -f /var/lib/watermelon/bootstrap-complete ]; then
        _WM_FIRST_BOOT=true
      fi
      # A completed legacy/final bootstrap necessarily completed the trusted
      # stage; never reopen networking merely because the newer marker is absent.
      if [ -f /var/lib/watermelon/bootstrap-complete ] && [ ! -f /var/lib/watermelon/trusted-bootstrap-complete ]; then
        mkdir -p /var/lib/watermelon
        touch /var/lib/watermelon/trusted-bootstrap-complete
      fi

      # The Lima identity is declared explicitly in this immutable config.
      # Privileged launch helpers bake it and never accept a caller-selected
      # user or group.
      _WM_USER={{ .VMUser }}
      _WM_UID=$(/usr/bin/id -u "$_WM_USER")
      _WM_GID=$(/usr/bin/id -g "$_WM_USER")
      _WM_HOME=$(/usr/bin/getent passwd "$_WM_USER" | /usr/bin/cut -d: -f6)
      case "$_WM_UID:$_WM_GID" in
        *[!0-9:]*)
          echo "unsafe Lima VM numeric identity" >&2
          exit 1
          ;;
      esac
      if [ "$_WM_UID" != "{{ .VMUserUID }}" ] || [ "$_WM_GID" = 0 ]; then
        echo "Lima VM identity unexpectedly has privileged numeric IDs" >&2
        exit 1
      fi
      if [ "$_WM_HOME" != "{{ .VMUserHome }}" ]; then
        echo "Lima VM home directory does not match the immutable policy identity" >&2
        exit 1
      fi

      # Lima grants its login user broad passwordless sudo by default. A later
      # sudoers entry revokes it before any workload can run, then grants only
      # the fixed, root-owned process launchers generated by this policy.
      wm_install_sudoers() {
        _WM_SUDOERS_TMP=$(/usr/bin/mktemp /etc/sudoers.d/.99-watermelon.XXXXXX)
        /bin/cat > "$_WM_SUDOERS_TMP" << SUDOERS
      $_WM_USER ALL=(ALL:ALL) !ALL
{{- range $proc := .SortedProcessNames }}
{{- $kernelID := index $.ProcessKernelIDs $proc }}
      $_WM_USER ALL=(root:root) NOPASSWD:NOSETENV: /usr/local/libexec/watermelon/process-{{ $kernelID }}
{{- end }}
      SUDOERS
        /bin/chown root:root "$_WM_SUDOERS_TMP"
        /bin/chmod 0440 "$_WM_SUDOERS_TMP"
        /usr/sbin/visudo -cf "$_WM_SUDOERS_TMP"
        /bin/mv -f "$_WM_SUDOERS_TMP" /etc/sudoers.d/99-watermelon
        /usr/sbin/visudo -cf /etc/sudoers
      }
      wm_install_sudoers

{{- if .WorkspaceDisk }}
      # Only the disk root is managed by privileged provisioning. Never follow
      # a workspace-controlled symlink or recursively chown retained data.
      _WM_VOLUME=/mnt/lima-{{ .WorkspaceDisk }}
      /usr/bin/mountpoint -q "$_WM_VOLUME"
      if [ -L /workspace ]; then
        [ "$(/usr/bin/readlink /workspace)" = "$_WM_VOLUME" ]
      elif [ -e /workspace ]; then
        echo "refusing unexpected /workspace path" >&2; exit 1
      else
        /bin/ln -s "$_WM_VOLUME" /workspace
      fi
      for _wm_dir in project home logs; do
        if [ -L "$_WM_VOLUME/$_wm_dir" ]; then
          echo "refusing symlink workspace directory $_wm_dir" >&2; exit 1
        elif [ ! -e "$_WM_VOLUME/$_wm_dir" ]; then
          /usr/bin/install -d -o "$_WM_UID" -g "$_WM_GID" -m 0700 "$_WM_VOLUME/$_wm_dir"
        else
          [ -d "$_WM_VOLUME/$_wm_dir" ]
        fi
      done
{{- end }}

      /bin/mkdir -p /usr/local/libexec/watermelon /var/empty
      /bin/chown root:root /usr/local/libexec /usr/local/libexec/watermelon /var/empty
      /bin/chmod 0755 /usr/local/libexec /usr/local/libexec/watermelon /var/empty
{{- if .BootstrapImages }}
      # Resolve Lima's nerdctl without consulting aliases or shell functions,
      # verify the binary, then preserve a private root-owned copy. This keeps
      # privileged helpers independent of PATH, caller environment, and tool
      # wrappers that may later be installed in /usr/local/bin.
      _WM_NERDCTL=/usr/local/libexec/watermelon/nerdctl
      _WM_NERDCTL_VALID=false
      if [ -f "$_WM_NERDCTL" ] && [ ! -L "$_WM_NERDCTL" ] && [ -x "$_WM_NERDCTL" ] && [ "$(/usr/bin/stat -c %u "$_WM_NERDCTL")" = 0 ] && [ "$(/usr/bin/od -An -t x1 -N4 "$_WM_NERDCTL" | /usr/bin/tr -d ' \n')" = 7f454c46 ]; then
        _WM_NERDCTL_VALID=true
      fi
      if [ "$_WM_NERDCTL_VALID" != true ]; then
        if [ -f /var/lib/watermelon/trusted-bootstrap-complete ]; then
          echo "the private verified nerdctl is missing or invalid after trusted bootstrap" >&2
          exit 1
        fi
        _WM_NERDCTL_SOURCE=""
        for _WM_NERDCTL_CANDIDATE in /usr/local/bin/nerdctl /usr/bin/nerdctl; do
          [ -e "$_WM_NERDCTL_CANDIDATE" ] || continue
          _WM_NERDCTL_CANDIDATE=$(/usr/bin/readlink -f -- "$_WM_NERDCTL_CANDIDATE")
          if [ -f "$_WM_NERDCTL_CANDIDATE" ] && [ ! -L "$_WM_NERDCTL_CANDIDATE" ] && [ -x "$_WM_NERDCTL_CANDIDATE" ] && [ "$(/usr/bin/stat -c %u "$_WM_NERDCTL_CANDIDATE")" = 0 ] && [ "$(/usr/bin/od -An -t x1 -N4 "$_WM_NERDCTL_CANDIDATE" | /usr/bin/tr -d ' \n')" = 7f454c46 ]; then
            _WM_NERDCTL_SOURCE=$_WM_NERDCTL_CANDIDATE
            break
          fi
        done
        case "$_WM_NERDCTL_SOURCE" in
          ""{{ if .MountProject }}|/project|/project/*{{ end }}|/mnt/watermelon|/mnt/watermelon/*|/tmp|/tmp/*|/var/tmp|/var/tmp/*|/run/user|/run/user/*|/dev/shm|/dev/shm/*|"$_WM_HOME"|"$_WM_HOME"/*)
            echo "nerdctl resolved to an unsafe guest-writable location" >&2
            exit 1
            ;;
        esac
        if [ ! -f "$_WM_NERDCTL_SOURCE" ] || [ -L "$_WM_NERDCTL_SOURCE" ] || [ ! -x "$_WM_NERDCTL_SOURCE" ] || [ "$(/usr/bin/stat -c %u "$_WM_NERDCTL_SOURCE")" != 0 ] || [ "$(/usr/bin/od -An -t x1 -N4 "$_WM_NERDCTL_SOURCE" | /usr/bin/tr -d ' \n')" != 7f454c46 ]; then
          echo "nerdctl must resolve to a root-owned regular ELF executable" >&2
          exit 1
        fi
        _WM_NERDCTL_TMP=$(/usr/bin/mktemp /usr/local/libexec/watermelon/.nerdctl.XXXXXX)
        /usr/bin/install -o root -g root -m 0755 "$_WM_NERDCTL_SOURCE" "$_WM_NERDCTL_TMP"
        /bin/mv -f "$_WM_NERDCTL_TMP" "$_WM_NERDCTL"
      fi
      wm_nerdctl() {
        /usr/sbin/runuser -u "$_WM_USER" -- /usr/bin/env -i \
          HOME="$_WM_HOME" USER="$_WM_USER" LOGNAME="$_WM_USER" \
          PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
          XDG_RUNTIME_DIR="/run/user/$_WM_UID" \
          "$_WM_NERDCTL" "$@"
      }
      wm_root_nerdctl() {
        /usr/bin/env -i HOME=/var/empty XDG_CONFIG_HOME=/var/empty \
          PATH=/usr/sbin:/usr/bin:/sbin:/bin \
          "$_WM_NERDCTL" --address /run/containerd/containerd.sock --namespace default "$@"
      }
{{- end }}
{{- if .NetworkProcessRules }}
      # Reconcile any partial per-process state before this run. Kernel state is
      # ephemeral across reboots, but a failed same-boot provision may leave it.
{{- $cleanupIndex := 1 }}
{{- range $proc := .SortedProcessNames }}
{{- $kernelID := index $.ProcessKernelIDs $proc }}
      _WM_PROC_DNS_PID=""
      if [ -f /run/watermelon-process-{{ $kernelID }}-dns.pid ]; then
        _WM_PROC_DNS_PID=$(cat /run/watermelon-process-{{ $kernelID }}-dns.pid 2>/dev/null || true)
      fi
      if [ -n "$_WM_PROC_DNS_PID" ] && [ "$(cat "/proc/$_WM_PROC_DNS_PID/comm" 2>/dev/null || true)" = dnsmasq ]; then
        kill "$_WM_PROC_DNS_PID" 2>/dev/null || true
      fi
      rm -f /run/watermelon-process-{{ $kernelID }}-dns.pid
      while iptables -w -D FORWARD -i wh-{{ $kernelID }} -j WMF_{{ $kernelID }} 2>/dev/null; do :; done
      while iptables -w -D FORWARD -o wh-{{ $kernelID }} -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null; do :; done
      iptables -w -F WMF_{{ $kernelID }} 2>/dev/null || true
      iptables -w -X WMF_{{ $kernelID }} 2>/dev/null || true
      while iptables -w -t nat -D PREROUTING -i wh-{{ $kernelID }} -p tcp --dport 53 -j DNAT --to-destination 10.200.{{ $cleanupIndex }}.1:53 2>/dev/null; do :; done
      while iptables -w -t nat -D PREROUTING -i wh-{{ $kernelID }} -p udp --dport 53 -j DNAT --to-destination 10.200.{{ $cleanupIndex }}.1:53 2>/dev/null; do :; done
      while iptables -w -t nat -D POSTROUTING -s 10.200.{{ $cleanupIndex }}.0/24 -j MASQUERADE 2>/dev/null; do :; done
      ip netns delete wmns-{{ $kernelID }} 2>/dev/null || true
      ip link delete wh-{{ $kernelID }} 2>/dev/null || true
{{- $cleanupIndex = add $cleanupIndex 1 }}
{{- end }}
{{- end }}

      if [ ! -f /var/lib/watermelon/trusted-bootstrap-complete ]; then
        # A failed bootstrap may have left a partial full policy behind. Return
        # to the intentional trusted-bootstrap state before controlled downloads.
        wm_reset_root_policy
        wm_delete_jump filter OUTPUT WM_EARLY
        iptables -w -P OUTPUT ACCEPT
{{- if .RejectUnknown }}
        # Install, but do not start, the fail-closed policy used at the beginning
        # of every subsequent boot. First bootstrap remains intentionally open.
        cat > /usr/local/sbin/watermelon-early-firewall << 'EARLYFIREWALL'
      #!/bin/sh
      set -eu
      PATH=/usr/sbin:/usr/bin:/sbin:/bin
      export PATH
      iptables -w -P OUTPUT DROP
      iptables -w -P FORWARD DROP
      if command -v ip6tables >/dev/null 2>&1; then
        ip6tables -w -P OUTPUT DROP
        ip6tables -w -P FORWARD DROP
      fi
      iptables -w -N WM_EARLY 2>/dev/null || true
      iptables -w -F WM_EARLY
      while iptables -w -D OUTPUT -j WM_EARLY 2>/dev/null; do :; done
      iptables -w -A WM_EARLY -o lo -j ACCEPT
      iptables -w -A WM_EARLY -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
      # DHCPv4 is the only pre-policy network bootstrap traffic permitted.
      iptables -w -A WM_EARLY -p udp --sport 68 --dport 67 -d 255.255.255.255 -j ACCEPT
      iptables -w -A WM_EARLY -j DROP
      iptables -w -I OUTPUT 1 -j WM_EARLY
      if [ -e /proc/sys/net/ipv6/conf/all/disable_ipv6 ]; then
        sysctl -q -w net.ipv6.conf.all.disable_ipv6=1
        sysctl -q -w net.ipv6.conf.default.disable_ipv6=1
      fi
      EARLYFIREWALL
        chmod 0755 /usr/local/sbin/watermelon-early-firewall
        cat > /etc/systemd/system/watermelon-early-firewall.service << 'EARLYSERVICE'
      [Unit]
      Description=Watermelon early fail-closed network policy
      DefaultDependencies=no
      Wants=local-fs.target network-pre.target
      After=local-fs.target systemd-modules-load.service systemd-sysctl.service
      Before=network-pre.target shutdown.target
      Conflicts=shutdown.target
      ConditionPathExists=/var/lib/watermelon/trusted-bootstrap-complete

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/watermelon-early-firewall
      RemainAfterExit=yes

      [Install]
      WantedBy=sysinit.target
      EARLYSERVICE
        mkdir -p /etc/systemd/system/systemd-networkd.service.d
        cat > /etc/systemd/system/systemd-networkd.service.d/watermelon-early-firewall.conf << 'NETWORKDDROPIN'
      [Unit]
      Requires=watermelon-early-firewall.service
      After=watermelon-early-firewall.service
      NETWORKDDROPIN
        mkdir -p /etc/sysctl.d
        cat > /etc/sysctl.d/99-watermelon-network.conf << 'SYSCTL'
      net.ipv6.conf.all.disable_ipv6 = 1
      net.ipv6.conf.default.disable_ipv6 = 1
      SYSCTL
        systemctl daemon-reload
        systemctl enable watermelon-early-firewall.service
{{- end }}
        # A failed first bootstrap may have left the restrictive resolver
        # enabled. Restore host-provided DNS before trusted downloads retry.
        systemctl stop watermelon-dns.service 2>/dev/null || true
        rm -f /etc/systemd/resolved.conf.d/watermelon.conf
        systemctl restart systemd-resolved
        _WM_DNS_READY=false
        for _i in $(seq 1 30); do
          if getent ahostsv4 dns.google >/dev/null 2>&1; then
            _WM_DNS_READY=true
            break
          fi
          sleep 1
        done
        if [ "$_WM_DNS_READY" != true ]; then
          echo "trusted bootstrap DNS did not become ready" >&2
          exit 1
        fi

        # Trusted bootstrap prerequisites. Configured package installation is
        # deliberately deferred until after policy becomes active.
        wm_install_bootstrap_prerequisites() {
          _wm_apt_status=1
          for _wm_apt_attempt in 1 2 3; do
            if apt-get update && apt-get install -y dnsmasq-base ipset{{ if or .WorkspaceDisk .SetupImage }} git python3{{ end }}; then
              return 0
            else
              _wm_apt_status=$?
            fi
            echo "trusted bootstrap APT attempt $_wm_apt_attempt failed (status $_wm_apt_status)" >&2
            if [ "$_wm_apt_attempt" -lt 3 ]; then
              sleep 5
            fi
          done
          return "$_wm_apt_status"
        }
        wm_install_bootstrap_prerequisites
        if ! id -u watermelon-dns >/dev/null 2>&1; then
          useradd --system --user-group --no-create-home --shell /usr/sbin/nologin watermelon-dns
        fi
{{- if eq .Enforcement "ask" }}
        apt-get install -y libnetfilter-queue1
{{- end }}
{{- if .BootstrapImages }}
{{- if .SetupImage }}
        # A restart reuses the prepared SDKs. Rebuild creates a fresh VM and
        # explicitly refreshes images; it does not reuse this compute cache.
        _WM_SETUP_IMAGES_READY=true
        wm_nerdctl image inspect {{ shellQuote .SetupImage }} >/dev/null 2>&1 || _WM_SETUP_IMAGES_READY=false
{{- range .BootstrapImages }}
        wm_nerdctl image inspect {{ shellQuote . }} >/dev/null 2>&1 || _WM_SETUP_IMAGES_READY=false
{{- end }}
        if [ "$_WM_SETUP_IMAGES_READY" != true ]; then
{{- end }}
        # Pull configured base images while trusted bootstrap has network.
{{- range .BootstrapImages }}
        wm_nerdctl pull "{{ . }}"
{{- end }}
{{- if .SetupRust }}
        # Official Rust images contain the minimal toolchain. Add the fixed
        # development components to the guest's image before enforcement.
        # No project files, mounts or project-selected commands enter this step.
        wm_nerdctl rm -f watermelon-rust-setup >/dev/null 2>&1 || true
        wm_nerdctl run --name watermelon-rust-setup --network=host {{ shellQuote .SetupRustImage }} /bin/sh -c 'exec /usr/local/cargo/bin/rustup component add --toolchain "$RUST_VERSION" rustfmt clippy'
        wm_nerdctl commit watermelon-rust-setup {{ shellQuote .SetupRustImage }}
        wm_nerdctl rm watermelon-rust-setup
{{- end }}
{{- if .SetupExtendedAssembly }}
{{- if .SetupPHP }}
        wm_nerdctl rm -f watermelon-php-setup >/dev/null 2>&1 || true
        wm_nerdctl run --user 0:0 --name watermelon-php-setup --network=host --entrypoint /bin/sh {{ shellQuote .SetupPHPImage }} -c 'set -eu; apt-get update; apt-get install -y --no-install-recommends libicu-dev libzip-dev libpq-dev; docker-php-ext-install -j2 intl zip bcmath pdo_mysql mysqli pdo_pgsql; rm -rf /var/lib/apt/lists/*'
        wm_nerdctl commit watermelon-php-setup {{ shellQuote .SetupPHPImage }}
        wm_nerdctl rm watermelon-php-setup
{{- end }}
        _WM_COMPOSE_STAGE=$(/usr/bin/mktemp -d /tmp/watermelon-tools.XXXXXXXX)
        /bin/chown "$_WM_USER:$_WM_USER" "$_WM_COMPOSE_STAGE"
{{- range .SetupAssemblyCopies }}
        wm_nerdctl run --rm --user 0:0 --network=none -v "$_WM_COMPOSE_STAGE:/watermelon-toolchains" --entrypoint /bin/sh {{ shellQuote .Image }} -c {{ shellQuote .Script }}
{{- end }}
        wm_nerdctl rm -f watermelon-combined-setup >/dev/null 2>&1 || true
        wm_nerdctl run --user 0:0 --name watermelon-combined-setup --network=host -v "$_WM_COMPOSE_STAGE:/watermelon-toolchains:ro" --entrypoint /bin/sh {{ shellQuote .SetupBaseImage }} -c 'set -eu; cp -a /watermelon-toolchains/usr/local/. /usr/local/; apt-get update; DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends build-essential pkg-config cmake ninja-build clang libicu72 libzip4 libpq5 libyaml-0-2 libgmp10 libreadline8 libgdbm6 libgdbm-compat4 libffi8 libdb5.3 libssl3 libncurses6 libedit2 libsodium23 libargon2-1 libonig5 libxml2 libsqlite3-0 libfontconfig1 libfreetype6 libasound2; printf "%s\n" /usr/local/lib64 > /etc/ld.so.conf.d/watermelon.conf; /sbin/ldconfig; rm -rf /var/lib/apt/lists/*'
        wm_nerdctl commit watermelon-combined-setup {{ shellQuote .SetupImage }}
        wm_nerdctl rm watermelon-combined-setup
        /bin/rm -rf -- "$_WM_COMPOSE_STAGE"
{{- end }}
{{- if and .SetupComposeSources (not .SetupExtendedAssembly) }}
        # Assemble only reviewed official toolchains. These fixed copy commands
        # see a guest staging directory and never mount repository/host files.
        _WM_COMPOSE_STAGE=$(/usr/bin/mktemp -d /tmp/watermelon-tools.XXXXXXXX)
        /bin/chown "$_WM_USER:$_WM_USER" "$_WM_COMPOSE_STAGE"
{{- range .SetupComposeSources }}
        wm_nerdctl run --rm --network=none -v "$_WM_COMPOSE_STAGE:/watermelon-toolchains" {{ shellQuote . }} /bin/sh -c 'cp -a /usr/local/. /watermelon-toolchains/'
{{- end }}
        wm_nerdctl rm -f watermelon-combined-setup >/dev/null 2>&1 || true
        wm_nerdctl run --name watermelon-combined-setup --network=none -v "$_WM_COMPOSE_STAGE:/watermelon-toolchains:ro" {{ shellQuote .SetupBaseImage }} /bin/sh -c 'cp -a /watermelon-toolchains/. /usr/local/ && /sbin/ldconfig'
        wm_nerdctl commit watermelon-combined-setup {{ shellQuote .SetupImage }}
        wm_nerdctl rm watermelon-combined-setup
        /bin/rm -rf -- "$_WM_COMPOSE_STAGE"
{{- end }}
{{- if .SetupImage }}
        fi
{{- end }}
{{- end }}
{{- if .RejectUnknown }}
        # Snapshot configured exact names while trusted DNS is available. These
        # files let enforcing reboots construct rules without a temporary DNS hole.
        mkdir -p /etc/watermelon
        wm_capture_dns_host() {
          _WM_HOST="$1"
          _WM_DEST="$2"
          _WM_CAPTURE=$(mktemp)
          if ! getent ahostsv4 "$_WM_HOST" | awk -v host="$_WM_HOST" '!seen[$1]++ { print $1, host }' > "$_WM_CAPTURE"; then
            rm -f "$_WM_CAPTURE"
            echo "failed to resolve required exact host $_WM_HOST" >&2
            return 1
          fi
          if [ ! -s "$_WM_CAPTURE" ]; then
            rm -f "$_WM_CAPTURE"
