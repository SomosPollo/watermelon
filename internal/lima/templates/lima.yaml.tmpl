      _wm_current=$(/bin/pwd -P)
      _wm_real_root=$(/usr/bin/realpath -e "$_wm_root")
      case "$_wm_current/" in "$_wm_real_root/"*) ;; *) echo "command workdir must stay within the project" >&2; exit 1 ;; esac
      _wm_relative=${_wm_current#"$_wm_real_root"}
      _wm_home={{ if .WorkspaceDisk }}/workspace/home{{ else }}{{ .VMUserHome }}/.watermelon-project{{ end }}
      _wm_venv={{ shellQuote .SetupDefaultVenv }}
      _wm_scan="$_wm_current"
      while :; do
        if [ -f "$_wm_scan/.venv/pyvenv.cfg" ] && { [ -x "$_wm_scan/.venv/bin/python" ] || [ -L "$_wm_scan/.venv/bin/python" ]; }; then _wm_venv="$_wm_root${_wm_scan#"$_wm_real_root"}/.venv"; break; fi
        [ "$_wm_scan" = "$_wm_real_root" ] && break
        _wm_scan=${_wm_scan%/*}
      done
      /bin/mkdir -p -- "$_wm_home"
      _wm_tty=()
      if [ -t 0 ] && [ -t 1 ]; then _wm_tty=(-it); else _wm_tty=(-i); fi
      exec /usr/local/libexec/watermelon/nerdctl run --rm "${_wm_tty[@]}" --network=host --pull=never \
        -v "$_wm_root:$_wm_root" -v "$_wm_home:$_wm_home" -v /usr/local/share/watermelon-runtime:/watermelon-runtime:ro -w "$_wm_root$_wm_relative" \
        --env WATERMELON_SANDBOX=1 --env 'PS1=(watermelon) \w \$ ' \
        --env "HOME=$_wm_home" --env "VIRTUAL_ENV=$_wm_venv" \
        --env UV_PYTHON_DOWNLOADS=never --env POETRY_VIRTUALENVS_IN_PROJECT=true \
{{- if .SetupJava }}
        --env JAVA_HOME=/usr/local/java --env MAVEN_HOME=/usr/local/share/maven --env GRADLE_HOME=/usr/local/share/gradle --env "GRADLE_USER_HOME=$_wm_home/.gradle" \
        --env "MAVEN_OPTS=-Duser.home=$_wm_home -Dmaven.repo.local=$_wm_home/.m2/repository" --env "MAVEN_USER_HOME=$_wm_home/.m2" --env "GRADLE_OPTS=-Duser.home=$_wm_home" \
{{- end }}
{{- if .SetupDotnet }}
        --env DOTNET_ROOT=/usr/local/share/dotnet --env "DOTNET_CLI_HOME=$_wm_home/.dotnet" --env "NUGET_PACKAGES=$_wm_home/.nuget/packages" \
        --env DOTNET_CLI_TELEMETRY_OPTOUT=1 --env DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 --env DOTNET_NOLOGO=1 --env DOTNET_GENERATE_ASPNET_CERTIFICATE=false --env DOTNET_MULTILEVEL_LOOKUP=0 \
{{- end }}
{{- if .SetupCPP }}
        --env LD_LIBRARY_PATH=/usr/local/lib64:/usr/local/lib --env CC=/usr/local/bin/gcc --env CXX=/usr/local/bin/g++ \
{{- end }}
{{- if .SetupRuby }}
        --env "GEM_HOME=$_wm_home/.gem" --env "BUNDLE_USER_HOME=$_wm_home/.bundle" --env "BUNDLE_PATH=$_wm_home/.bundle/gems" \
{{- end }}
{{- if .SetupPHP }}
        --env PHPRC=/usr/local/etc/php --env PHP_INI_SCAN_DIR=/usr/local/etc/php/conf.d --env "COMPOSER_HOME=$_wm_home/.composer" --env "COMPOSER_CACHE_DIR=$_wm_home/.cache/composer" --env COMPOSER_ALLOW_SUPERUSER=1 --env COMPOSER_IPRESOLVE=4 \
{{- end }}
{{- if .SetupGo }}
        --env "GOPATH=$_wm_home/go" --env "GOMODCACHE=$_wm_home/go/pkg/mod" --env "GOCACHE=$_wm_home/.cache/go-build" \
        --env GOTOOLCHAIN=local --env GOENV=off --env GOPROXY=https://proxy.golang.org --env GOSUMDB=sum.golang.org \
        --env GOPRIVATE= --env GONOPROXY=none --env GONOSUMDB= --env GOVCS=off \
{{- end }}
{{- if .SetupRust }}
        --env "CARGO_HOME=$_wm_home/.cargo" --env RUSTUP_HOME=/usr/local/rustup --env CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse \
{{- end }}
        --env "PATH=/watermelon-runtime/bin:{{ if .SetupJava }}/usr/local/java/bin:/usr/local/share/maven/bin:/usr/local/share/gradle/bin:{{ end }}{{ if .SetupDotnet }}/usr/local/share/dotnet:{{ end }}{{ if .SetupRuby }}$_wm_home/.gem/bin:{{ end }}{{ if .SetupPython }}$_wm_venv/bin:{{ end }}{{ if .SetupGo }}$_wm_home/go/bin:/usr/local/go/bin:{{ end }}{{ if .SetupRust }}$_wm_home/.cargo/bin:/usr/local/cargo/bin:{{ end }}/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
{{- if .SetupRust }}
{{- if or .SetupComposeSources .SetupExtendedAssembly }}
        --entrypoint /bin/sh {{ shellQuote .SetupImage }} -c '_wm_toolchain=$(/usr/local/cargo/bin/rustup default); export RUSTUP_TOOLCHAIN="${_wm_toolchain%% *}"; export RUST_VERSION="${RUSTUP_TOOLCHAIN%%-*}"; exec "$@"' watermelon-runtime "$@"
{{- else }}
        --entrypoint /bin/sh {{ shellQuote .SetupImage }} -c 'export RUSTUP_TOOLCHAIN="${RUST_VERSION:?missing image toolchain version}"; exec "$@"' watermelon-runtime "$@"
{{- end }}
{{- else }}
        {{ shellQuote .SetupImage }} "$@"
{{- end }}
      WATERMELON_PROJECT
      /bin/chmod 0755 /usr/local/bin/watermelon-project
{{- range .SetupCommands }}
      /usr/bin/printf '%s\n' '#!/bin/sh' 'exec /usr/local/bin/watermelon-project {{ . }} "$@"' > /usr/local/bin/{{ . }}
      /bin/chmod 0755 /usr/local/bin/{{ . }}
{{- end }}
{{- end }}
{{- if .NetworkProcessRules }}
      # Per-process network namespaces
{{- $netIndex := 1 }}
{{- range $proc := .SortedProcessNames }}
{{- $domains := index $.NetworkProcessRules $proc }}
{{- $kernelID := index $.ProcessKernelIDs $proc }}
      # Setup namespace for {{ $proc }}
      ip netns add wmns-{{ $kernelID }}

      # Create veth pair
      ip link add wh-{{ $kernelID }} type veth peer name wn-{{ $kernelID }}
      ip link set wn-{{ $kernelID }} netns wmns-{{ $kernelID }}

      # Configure host side
      ip addr add 10.200.{{ $netIndex }}.1/24 dev wh-{{ $kernelID }}
      ip link set wh-{{ $kernelID }} up

      # Configure namespace side
      ip netns exec wmns-{{ $kernelID }} ip addr add 10.200.{{ $netIndex }}.2/24 dev wn-{{ $kernelID }}
      ip netns exec wmns-{{ $kernelID }} ip link set wn-{{ $kernelID }} up
      ip netns exec wmns-{{ $kernelID }} ip link set lo up
      ip netns exec wmns-{{ $kernelID }} ip route add default via 10.200.{{ $netIndex }}.1

      # Enable forwarding and NAT for this namespace
      iptables -w -t nat -A POSTROUTING -s 10.200.{{ $netIndex }}.0/24 -j MASQUERADE
      echo 1 > /proc/sys/net/ipv4/ip_forward

      # Create ipset for wildcard domains in ROOT namespace (ipset + nf_tables
      # don't work together inside network namespaces on Ubuntu 22.04)
      ipset create wm-{{ $kernelID }}-allow hash:ip -exist
      ipset flush wm-{{ $kernelID }}-allow

      # Configure a managed resolver for {{ $proc }}.
      # Runs in ROOT namespace on the host side of the veth (10.200.{{ $netIndex }}.1).
      # In fail/silent modes it forwards only global and process allow rules.
      mkdir -p /etc/watermelon
      cat > /etc/watermelon/process-{{ $kernelID }}-dns.conf << 'DNSCONF'
      # dnsmasq config for {{ $proc }}
      port=53
      bind-interfaces
      listen-address=10.200.{{ $netIndex }}.1
      no-resolv
      user=watermelon-dns
      group=watermelon-dns
      pid-file=/run/watermelon-process-{{ $kernelID }}-dns.pid
{{- if $.DNSAllowlistOnly }}
      no-hosts
      addn-hosts=/etc/watermelon/process-{{ $kernelID }}-allowed-hosts
{{- $wildcardHosts := index $.ProcessDNSWildcards $proc }}
{{- range $wildcardHosts }}
      server=/*.{{ . }}/8.8.8.8
      server=/*.{{ . }}/8.8.4.4
{{- end }}
      address=/#/
{{- else }}
{{- if $.RejectUnknown }}
      addn-hosts=/etc/watermelon/process-{{ $kernelID }}-allowed-hosts
{{- end }}
      server=8.8.8.8
      server=8.8.4.4
{{- end }}
{{- range $domains }}
{{- if .Wildcard }}
      ipset=/*.{{ .Host }}/wm-{{ $kernelID }}-allow
{{- end }}
{{- end }}
{{- range $.GlobalWildcardRules }}
      ipset=/*.{{ .Host }}/wm-{{ $kernelID }}-allow
{{- end }}
      DNSCONF
      dnsmasq --conf-file=/etc/watermelon/process-{{ $kernelID }}-dns.conf
      mkdir -p /etc/netns/wmns-{{ $kernelID }}
      echo "nameserver 10.200.{{ $netIndex }}.1" > /etc/netns/wmns-{{ $kernelID }}/resolv.conf

      # Filter traffic in root FORWARD chain (where ipset works correctly).
      # Create a per-process chain for clean separation.
      # Redirect attempts to use an arbitrary resolver back to the managed one.
      iptables -w -t nat -A PREROUTING -i wh-{{ $kernelID }} -p tcp --dport 53 -j DNAT --to-destination 10.200.{{ $netIndex }}.1:53
      iptables -w -t nat -A PREROUTING -i wh-{{ $kernelID }} -p udp --dport 53 -j DNAT --to-destination 10.200.{{ $netIndex }}.1:53
      iptables -w -N WMF_{{ $kernelID }}
      iptables -w -A WMF_{{ $kernelID }} -p tcp -d 10.200.{{ $netIndex }}.1 --dport 53 -j ACCEPT
      iptables -w -A WMF_{{ $kernelID }} -p udp -d 10.200.{{ $netIndex }}.1 --dport 53 -j ACCEPT
      iptables -w -A WMF_{{ $kernelID }} -m set --match-set wm-{{ $kernelID }}-allow dst -j ACCEPT
{{- range $.NetworkRules }}
{{- if not .Wildcard }}
      iptables -w -A WMF_{{ $kernelID }} {{ if .Port }}-p tcp --dport {{ .Port }} {{ end }}-d {{ .Host }} -j ACCEPT
{{- end }}
{{- end }}
{{- range $domains }}
{{- if not .Wildcard }}
      iptables -w -A WMF_{{ $kernelID }} {{ if .Port }}-p tcp --dport {{ .Port }} {{ end }}-d {{ .Host }} -j ACCEPT
{{- end }}
{{- end }}
{{- if $.LogUnknown }}
      iptables -w -A WMF_{{ $kernelID }} -m limit --limit 30/min -j LOG --log-prefix "watermelon-net " --log-level 4
{{- end }}
{{- if eq $.Enforcement "ask" }}
      iptables -w -A WMF_{{ $kernelID }} -p tcp --syn -j NFQUEUE --queue-num 0
{{- end }}
{{- if $.RejectUnknown }}
      iptables -w -A WMF_{{ $kernelID }} -j REJECT
{{- end }}
      # Route outbound traffic from this namespace through the filter chain;
      # allow return traffic unconditionally.
      iptables -w -I FORWARD 1 -i wh-{{ $kernelID }} -j WMF_{{ $kernelID }}
      iptables -w -I FORWARD 1 -o wh-{{ $kernelID }} -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

{{- $procImage := index $.NetworkProcessImages $proc }}
      # Reassert a root-owned fixed launcher on every boot. The public wrapper
      # can only sudo this exact path; all runtime-affecting values other than
      # arguments to the configured process are baked into the launcher.
{{- if $.BootstrapImages }}
      _WM_PROC_IMAGE="{{ $procImage }}"
      _WM_PROC_IMAGE_STATE=/var/lib/watermelon/process-{{ $kernelID }}-image
      if [ -z "$_WM_PROC_IMAGE" ] && [ -f "$_WM_PROC_IMAGE_STATE" ] && [ ! -L "$_WM_PROC_IMAGE_STATE" ] && [ "$(/usr/bin/stat -c %u "$_WM_PROC_IMAGE_STATE")" = 0 ] && [ "$(/usr/bin/stat -c %a "$_WM_PROC_IMAGE_STATE")" = 600 ]; then
        IFS= read -r _WM_PROC_IMAGE < "$_WM_PROC_IMAGE_STATE" || true
      fi
      if [ -z "$_WM_PROC_IMAGE" ] && [ -f "/usr/local/bin/{{ $proc }}" ]; then
        _WM_PROC_IMAGE=$(/usr/bin/awk '$1 == "#" && $2 == "watermelon-image:" { print $3; exit }' "/usr/local/bin/{{ $proc }}")
      fi
      case "$_WM_PROC_IMAGE" in
        *[!A-Za-z0-9._/@:+-]*) _WM_PROC_IMAGE="" ;;
      esac
      if [ -n "$_WM_PROC_IMAGE" ]; then
        _WM_IMAGE_STATE_TMP=$(/usr/bin/mktemp /var/lib/watermelon/.process-{{ $kernelID }}-image.XXXXXX)
        /usr/bin/printf '%s\n' "$_WM_PROC_IMAGE" > "$_WM_IMAGE_STATE_TMP"
        /bin/chown root:root "$_WM_IMAGE_STATE_TMP"
        /bin/chmod 0600 "$_WM_IMAGE_STATE_TMP"
        /bin/mv -f "$_WM_IMAGE_STATE_TMP" "$_WM_PROC_IMAGE_STATE"

        _WM_HELPER_TMP=$(/usr/bin/mktemp /usr/local/libexec/watermelon/.process-{{ $kernelID }}.XXXXXX)
        /bin/cat > "$_WM_HELPER_TMP" << CONTAINERHELPER
      #!/bin/bash -p
      set -euo pipefail
{{- if $.DynamicWorkdir }}
      _WM_WORKDIR=\$(/bin/pwd -P)
      case "\$_WM_WORKDIR" in
        /*) ;;
        *) echo "unable to resolve the guest workspace" >&2; exit 1 ;;
      esac
{{- end }}
      if [ -t 0 ]; then
        exec /usr/bin/env -i HOME=/var/empty XDG_CONFIG_HOME=/var/empty PATH=/usr/sbin:/usr/bin:/sbin:/bin \
          /usr/local/libexec/watermelon/nerdctl --address /run/containerd/containerd.sock --namespace default \
          run --rm -it --pull=never --network=ns:/var/run/netns/wmns-{{ $kernelID }} --dns 10.200.{{ $netIndex }}.1 \
          --user $_WM_UID:$_WM_GID --cap-drop=ALL --security-opt=no-new-privileges \
          --env HOME=/tmp --env USER=$_WM_USER --env LOGNAME=$_WM_USER \
          {{ $.HelperWorkdirArgs }} -- "$_WM_PROC_IMAGE" "{{ $proc }}" "\$@"
      else
        exec /usr/bin/env -i HOME=/var/empty XDG_CONFIG_HOME=/var/empty PATH=/usr/sbin:/usr/bin:/sbin:/bin \
          /usr/local/libexec/watermelon/nerdctl --address /run/containerd/containerd.sock --namespace default \
          run --rm --pull=never --network=ns:/var/run/netns/wmns-{{ $kernelID }} --dns 10.200.{{ $netIndex }}.1 \
          --user $_WM_UID:$_WM_GID --cap-drop=ALL --security-opt=no-new-privileges \
          --env HOME=/tmp --env USER=$_WM_USER --env LOGNAME=$_WM_USER \
          {{ $.HelperWorkdirArgs }} -- "$_WM_PROC_IMAGE" "{{ $proc }}" "\$@"
      fi
      CONTAINERHELPER
        /bin/chown root:root "$_WM_HELPER_TMP"
        /bin/chmod 0755 "$_WM_HELPER_TMP"
        /bin/mv -f "$_WM_HELPER_TMP" /usr/local/libexec/watermelon/process-{{ $kernelID }}
      else
{{- end }}
        # A native command enters the fixed namespace as root, then setpriv
        # irreversibly drops to the Lima UID/GID with no new privileges or caps.
        _WM_NATIVE_BACKUP=/usr/local/libexec/watermelon/native-{{ $kernelID }}
        _WM_REAL_BIN=""
        if [ -f "$_WM_NATIVE_BACKUP" ] && [ ! -L "$_WM_NATIVE_BACKUP" ] && [ -x "$_WM_NATIVE_BACKUP" ] && [ "$(/usr/bin/stat -c %u "$_WM_NATIVE_BACKUP")" = 0 ]; then
          _WM_REAL_BIN=$_WM_NATIVE_BACKUP
        else
          while IFS= read -r _WM_CANDIDATE; do
            [ "$_WM_CANDIDATE" = "/usr/local/bin/{{ $proc }}" ] && continue
            _WM_CANDIDATE=$(/usr/bin/readlink -f -- "$_WM_CANDIDATE")
            if [ -f "$_WM_CANDIDATE" ] && [ -x "$_WM_CANDIDATE" ]; then
              _WM_REAL_BIN=$_WM_CANDIDATE
              break
            fi
          done < <(type -aP -- "{{ $proc }}" 2>/dev/null || true)
          # If the command itself occupies the wrapper path, preserve a fixed
          # root-owned copy before atomically replacing that path.
          if [ -z "$_WM_REAL_BIN" ] && [ -f "/usr/local/bin/{{ $proc }}" ] && [ ! -L "/usr/local/bin/{{ $proc }}" ] && [ -x "/usr/local/bin/{{ $proc }}" ]; then
            /usr/bin/install -o root -g root -m 0755 "/usr/local/bin/{{ $proc }}" "$_WM_NATIVE_BACKUP"
            _WM_REAL_BIN=$_WM_NATIVE_BACKUP
          fi
        fi
        if [ -z "$_WM_REAL_BIN" ]; then
          echo "configured network process {{ $proc }} was not found in the trusted PATH" >&2
          exit 1
        fi
        printf -v _WM_REAL_BIN_Q '%q' "$_WM_REAL_BIN"
        printf -v _WM_HOME_Q '%q' "$_WM_HOME"
        printf -v _WM_USER_Q '%q' "$_WM_USER"
        _WM_HELPER_TMP=$(/usr/bin/mktemp /usr/local/libexec/watermelon/.process-{{ $kernelID }}.XXXXXX)
        /bin/cat > "$_WM_HELPER_TMP" << NATIVEHELPER
      #!/bin/bash -p
      set -euo pipefail
      exec /usr/sbin/ip netns exec wmns-{{ $kernelID }} \
        /usr/bin/setpriv --reuid=$_WM_UID --regid=$_WM_GID --init-groups \
          --no-new-privs --inh-caps=-all --ambient-caps=-all --bounding-set=-all -- \
        /usr/bin/env -i HOME=${_WM_HOME_Q} USER=${_WM_USER_Q} LOGNAME=${_WM_USER_Q} \
          PATH=/usr/local/bin:/usr/bin:/bin ${_WM_REAL_BIN_Q} "\$@"
      NATIVEHELPER
        /bin/chown root:root "$_WM_HELPER_TMP"
        /bin/chmod 0755 "$_WM_HELPER_TMP"
        /bin/mv -f "$_WM_HELPER_TMP" /usr/local/libexec/watermelon/process-{{ $kernelID }}
{{- if $.BootstrapImages }}
      fi
{{- end }}

      _WM_WRAPPER_TMP=$(/usr/bin/mktemp /usr/local/bin/.watermelon-{{ $kernelID }}.XXXXXX)
      /bin/cat > "$_WM_WRAPPER_TMP" << 'USERWRAPPER'
      #!/bin/sh
      exec /usr/bin/sudo -n -- /usr/local/libexec/watermelon/process-{{ $kernelID }} "$@"
      USERWRAPPER
      /bin/chown root:root "$_WM_WRAPPER_TMP"
      /bin/chmod 0755 "$_WM_WRAPPER_TMP"
      /bin/mv -f "$_WM_WRAPPER_TMP" /usr/local/bin/{{ $proc }}
{{- $netIndex = add $netIndex 1 }}
{{- end }}
{{- end }}
      # Validate the complete sudoers policy only after all fixed helpers exist,
      # and before publishing either completion marker.
      /usr/sbin/visudo -cf /etc/sudoers
      if [ "$_WM_FIRST_BOOT" = true ]; then
        mkdir -p /var/lib/watermelon
        touch /var/lib/watermelon/bootstrap-complete
      fi
      touch /run/watermelon-policy-applied

{{- range .ProvisionScripts }}
  # Configured provision scripts must be idempotent: Lima may run provisions again.
  # Execute the exact audited bytes as a child payload so a successful exit
  # still returns to this wrapper and publishes the stage marker, while any
  # non-zero result leaves the stage unmarked.
  - mode: system
    script: |
      #!/bin/bash
      set -euo pipefail
      export PATH=/usr/sbin:/usr/bin:/sbin:/bin
      # Ubuntu mounts /run with noexec, so keep only attestation markers there
      # and stage the executable payload in Watermelon's root-owned helper dir.
      _WM_PAYLOAD=$(/usr/bin/mktemp /usr/local/libexec/watermelon/.provision-{{ .Name }}.XXXXXX)
      wm_cleanup_provision_payload() {
        /bin/rm -f -- "$_WM_PAYLOAD"
      }
      trap wm_cleanup_provision_payload EXIT
      /usr/bin/base64 --decode > "$_WM_PAYLOAD" <<'WATERMELON_PROVISION_PAYLOAD'
{{ indent 6 .Base64 }}
      WATERMELON_PROVISION_PAYLOAD
      /bin/chown root:root "$_WM_PAYLOAD"
      /bin/chmod 0700 "$_WM_PAYLOAD"
      "$_WM_PAYLOAD"
      wm_cleanup_provision_payload
      trap - EXIT
      /usr/bin/install -o root -g root -m 0600 /dev/null /run/watermelon-provisioning/{{ .Name }}.complete
{{- end }}

{{- if .Workdir }}
  # Lima executes all system provisions before all user provisions regardless
  # of their YAML order. Keep this generated user-home change in the system
  # sequence so the final root-owned marker attests it as well.
  - mode: system
    script: |
      #!/bin/bash
      set -euo pipefail
      export PATH=/usr/sbin:/usr/bin:/sbin:/bin
      _WM_UID=$(/usr/bin/id -u {{ .VMUser }})
      _WM_GID=$(/usr/bin/id -g {{ .VMUser }})
      _WM_BASHRC={{ .VMUserHome }}/.bashrc
      if [ -e "$_WM_BASHRC" ] || [ -L "$_WM_BASHRC" ]; then
        if [ ! -f "$_WM_BASHRC" ] || [ -L "$_WM_BASHRC" ] || [ "$(/usr/bin/stat -c %u "$_WM_BASHRC")" != "$_WM_UID" ]; then
          echo "Watermelon: refusing unsafe $_WM_BASHRC" >&2
          exit 1
        fi
      else
        /usr/bin/install -o "$_WM_UID" -g "$_WM_GID" -m 0644 /dev/null "$_WM_BASHRC"
      fi
{{- if eq .Workdir "/project" }}
      _WM_WORKDIR_LINE='[ -d /project ] && cd /project'
{{- else }}
      _WM_WORKDIR_LINE={{ shellQuote (printf "[ -d %s ] && cd %s" (shellQuote .Workdir) (shellQuote .Workdir)) }}
{{- end }}
      if ! /usr/bin/grep -Fqx -- "$_WM_WORKDIR_LINE" "$_WM_BASHRC" 2>/dev/null; then
        /usr/bin/printf '%s\n' "$_WM_WORKDIR_LINE" >> "$_WM_BASHRC"
      fi
      /usr/bin/install -o root -g root -m 0600 /dev/null /run/watermelon-provisioning/workdir.complete
{{- end }}

  # Lima's own ready signal does not prove its provision scripts succeeded.
  # Publish Watermelon's marker only after every generated stage has left a
  # root-owned success marker in this boot's root-only runtime directory.
  - mode: system
    script: |
      #!/bin/bash
      set -euo pipefail
      export PATH=/usr/sbin:/usr/bin:/sbin:/bin
      wm_require_provision_stage() {
        _wm_stage="$1"
        if [ ! -f "$_wm_stage" ] || [ -L "$_wm_stage" ] || [ "$(/usr/bin/stat -c %u "$_wm_stage" 2>/dev/null)" != 0 ]; then
          echo "Watermelon provisioning stage did not complete: $_wm_stage" >&2
          exit 1
        fi
      }
      wm_require_provision_stage /run/watermelon-bootstrap-apt-configured
      wm_require_provision_stage /run/watermelon-policy-applied
{{- range .ProvisionScripts }}
      wm_require_provision_stage /run/watermelon-provisioning/{{ .Name }}.complete
{{- end }}
{{- if .Workdir }}
      wm_require_provision_stage /run/watermelon-provisioning/workdir.complete
{{- end }}
      /usr/bin/install -o root -g root -m 0600 /dev/null /run/watermelon-provisioning-complete

networks: []

portForwards:
{{- range .PortForwards }}
  - guestPort: {{ . }}
    hostPort: {{ . }}
    hostIP: "127.0.0.1"
{{- end }}
  # Disable automatic port forwarding for security isolation
  - ignore: true
    guestIP: "0.0.0.0"
    guestPortRange: [1, 65535]
  - ignore: true
    guestIP: "127.0.0.1"
    guestPortRange: [1, 65535]
